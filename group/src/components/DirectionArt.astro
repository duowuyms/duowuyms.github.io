---
import { url } from '../lib/urls';
interface Props {
  direction: string;
}
const { direction } = Astro.props;

// Complete figures extracted from the group's papers; see
// public/media/research-bands/README.md for sources and pages.
const media: Record<
  string,
  { image: string; width: number; height: number; alt: string; caption: string }
> = {
  agents: {
    image: 'media/research-bands/mobilegen-overview-figure.webp',
    width: 1800,
    height: 987,
    alt: 'MobileGen Figure 1: agent capability profiling on mobile apps, a target difficulty distribution, and difficulty-aware trajectory generation by explorer and supervisor agents',
    caption:
      'MobileGen, Figure 1. Mobile GUI agents trained on tasks matched to their ability.',
  },
  embodied: {
    image: 'media/research-bands/igen-real-world-figure.webp',
    width: 1800,
    height: 730,
    alt: 'IGen Figure 6: captured images of a robot arm workspace, IGen-generated training episodes, and the trained policy watering flowers, hitting a box, and placing a toy in the real world',
    caption:
      'IGen, Figure 6. From one captured image to generated data to a real robot.',
  },
  training: {
    image: 'media/research-bands/survey-paradigms-figure.webp',
    width: 1800,
    height: 674,
    alt: 'Figure 1 from Beyond a Single AI Cluster: community-driven and organizational decentralized training across GPU servers and cloud clusters linked by LAN and WAN',
    caption:
      'Beyond a Single AI Cluster, Figure 1. Training across servers and clusters linked by LAN and WAN.',
  },
};

const item = media[direction];
---

{item && (
  <figure class="tile-figure">
    <img
      src={url(item.image)}
      width={item.width}
      height={item.height}
      alt={item.alt}
      loading="lazy"
      decoding="async"
    />
    <figcaption>{item.caption}</figcaption>
  </figure>
)}
