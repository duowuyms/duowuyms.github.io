---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro page-gutter">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="display">{title}</h1>
  {description && <p class="intro-copy">{description}</p>}
  <slot />
</header>
