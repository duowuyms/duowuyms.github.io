---
import type { Person } from '../data/site';
import { url } from '../lib/urls';
interface Props {
  person: Person;
  role: string;
  note?: string;
  large?: boolean;
}
const { person, role, note, large = false } = Astro.props;
// Members without a homepage portrait get a neutral placeholder, never an
// invented photo.
---

<div class:list={['member', { 'member-large': large }]}>
  {person.photo ? (
    <img
      class="member-photo"
      src={url(person.photo)}
      alt=""
      width="320"
      height="320"
      loading={large ? 'eager' : 'lazy'}
    />
  ) : (
    <span class="member-photo member-placeholder" aria-hidden="true">
      <svg viewBox="0 0 64 64" focusable="false">
        <circle cx="32" cy="24" r="12" />
        <path d="M10 58c2-12 11-19 22-19s20 7 22 19z" />
      </svg>
    </span>
  )}
  {person.url ? (
    <a
      class="member-name"
      href={person.url}
      target="_blank"
      rel="noopener noreferrer"
    >
      {person.name}
      <span class="sr-only"> (personal website)</span>
    </a>
  ) : (
    <span class="member-name">{person.name}</span>
  )}
  <span class="member-role">{role}</span>
  {note && <span class="member-note">{note}</span>}
</div>
