---
import type { Publication } from '../data/publications';
import abstracts from '../data/abstracts.json';
import { topics } from '../data/publications';
import { paperFigures } from '../data/selected-work';
import { url } from '../lib/urls';
interface Props {
  publication: Publication;
}
const { publication: p } = Astro.props;
const abstract = p.abstract || abstracts[p.id as keyof typeof abstracts];
const figure = paperFigures[p.id];
// Venue line in the academic idiom: always ends with the year.
const venue = /\b\d{4}\b/.test(p.venue) ? p.venue : `${p.venue}, ${p.year}`;
---

<article
  class="publication-row"
  id={p.id}
  data-publication
  data-topic={p.topic}
  data-year={p.year}
>
  {figure ? (
    <a
      class="publication-image"
      href={p.links[0]?.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${p.name} paper`}
    >
      <img src={url(figure.image)} alt={figure.alt} loading="lazy" />
    </a>
  ) : (
    <div class="publication-monogram" aria-hidden="true">
      {p.name}
    </div>
  )}
  <div class="publication-content">
    <h3>{p.title}</h3>
    <p class="authors">{p.authors}</p>
    <p class="publication-venue">
      <em>{venue}</em>
      <span>{topics[p.topic]}</span>
    </p>
    <p class="publication-summary">{p.summary}</p>
    {(p.links.length > 0 || abstract) && (
      <div class="publication-links">
        {p.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="sr-only">: {p.name}</span>
          </a>
        ))}
        {abstract && (
          <button
            class="abstract-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={`${p.id}-abstract`}
          >
            Abstract<span class="sr-only">: {p.name}</span>
          </button>
        )}
      </div>
    )}
    {abstract && (
      <div class="abstract" id={`${p.id}-abstract`}>
        <p>{abstract}</p>
      </div>
    )}
  </div>
</article>
