---
import SiteLayout from '../layouts/SiteLayout.astro';
import SelectedWork from '../components/SelectedWork.astro';
import AboutUs from '../components/AboutUs.astro';
import DirectionArt from '../components/DirectionArt.astro';
import { site } from '../data/site';
import { directions } from '../data/research';
import { publications } from '../data/publications';
import { url } from '../lib/urls';
---

<SiteLayout>
  <div class="home-stage">
    <section class="home-hero page-gutter" aria-labelledby="group-title">
      <p class="hero-affiliation">{site.affiliation}</p>
      <h1 id="group-title">
        <span>Agentic and Embodied</span>
        <span>Large Model Training Group</span>
      </h1>
      <p class="hero-subtitle">
        We build agents that reason, robots that learn, and systems that make
        large-scale training possible.
      </p>
      <div class="hero-links">
        <a href="#directions">
          Explore our research <span aria-hidden="true">›</span>
        </a>
        <a href={url('publications/')}>
          Publications <span aria-hidden="true">›</span>
        </a>
      </div>
    </section>
    <SelectedWork />
  </div>
  <AboutUs />
  <section
    class="directions"
    id="directions"
    aria-labelledby="directions-title"
  >
    <header class="directions-intro page-gutter">
      <h2 id="directions-title">Research Directions</h2>
      <p>
        Large models that reason, act in the physical world, and train at scale.
      </p>
    </header>
    <div class="direction-tiles page-gutter">
      {directions.map((direction) => (
        <article
          class="direction-tile"
          id={direction.id}
          aria-labelledby={`${direction.id}-heading`}
        >
          <div class="tile-copy">
            <h3 id={`${direction.id}-heading`}>{direction.title}</h3>
            <p class="tile-summary">{direction.summary}</p>
            <ul
              class="tile-topics"
              aria-label={`${direction.title} research topics`}
            >
              {direction.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
            <ul
              class="tile-papers"
              aria-label={`${direction.title} publications`}
            >
              {direction.publications.map((id) => {
                const paper = publications.find((p) => p.id === id)!;
                return (
                  <li>
                    <a href={url(`publications/#${paper.id}`)}>
                      {paper.name}
                      <small>
                        {paper.venue === 'Preprint'
                          ? `${paper.year} preprint`
                          : paper.venue}
                      </small>
                    </a>
                  </li>
                );
              })}
            </ul>
            <a
              class="tile-link"
              href={url(`publications/?topic=${direction.id}`)}
            >
              See {direction.title} papers <span aria-hidden="true">›</span>
            </a>
          </div>
          <DirectionArt direction={direction.id} />
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
