---
import SiteLayout from '../layouts/SiteLayout.astro';
import SelectedWork from '../components/SelectedWork.astro';
import AboutUs from '../components/AboutUs.astro';
import DirectionArt from '../components/DirectionArt.astro';
import { site } from '../data/site';
import { directions } from '../data/research';
import { url } from '../lib/urls';
---

<SiteLayout>
  <div class="home-stage">
    <section class="home-hero page-gutter" aria-labelledby="group-title">
      <p class="hero-affiliation">{site.affiliation}</p>
      <h1 id="group-title">
        <span>Agentic and Embodied</span>
        <span>Large Model Training Group</span>
      </h1>
      <p class="hero-subtitle">
        We build agents that reason, robots that learn, and systems that make
        large-scale training possible.
      </p>
      <div class="hero-links">
        <a href="#directions">
          Explore our research <span aria-hidden="true">›</span>
        </a>
        <a href={url('publications/')}>
          Publications <span aria-hidden="true">›</span>
        </a>
      </div>
    </section>
    <SelectedWork />
  </div>
  <AboutUs />
  <div class="directions-heading page-gutter" id="directions">
    <h2 class="section-title">Research Directions</h2>
  </div>
  {directions.map((direction) => (
    <section
      class:list={['direction-band', direction.id]}
      id={direction.id}
      aria-labelledby={`${direction.id}-heading`}
    >
      <div class="direction-copy">
        <>
          <h2 id={`${direction.id}-heading`}>{direction.title}</h2>
          <p>{direction.summary}</p>
          <ul
            class="direction-topics"
            aria-label={`${direction.name} research topics`}
          >
            {direction.topics.map((topic) => (
              <li>{topic}</li>
            ))}
          </ul>
          <a
            class="text-link"
            href={url(`publications/?topic=${direction.id}`)}
          >
            See {direction.title} papers <span aria-hidden="true">↗</span>
          </a>
        </>
      </div>
      <DirectionArt direction={direction.id} />
    </section>
  ))}
</SiteLayout>
