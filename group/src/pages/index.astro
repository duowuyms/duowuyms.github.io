---
import SiteLayout from '../layouts/SiteLayout.astro';
import SelectedWork from '../components/SelectedWork.astro';
import AboutUs from '../components/AboutUs.astro';
import DirectionArt from '../components/DirectionArt.astro';
import { site } from '../data/site';
import { directions } from '../data/research';
import { url } from '../lib/urls';
---

<SiteLayout>
  <div class="home-stage">
    <section class="home-hero page-gutter" aria-labelledby="group-title">
      <p class="hero-affiliation">{site.affiliation}</p>
      <h1 id="group-title">
        <span>Agentic and Embodied</span>
        <span>Large Model Training Group</span>
      </h1>
      <p class="hero-subtitle">
        We build agents that reason, robots that learn, and systems that make
        large-scale training possible.
      </p>
      <div class="hero-links">
        <a href="#directions">
          Explore our research <span aria-hidden="true">›</span>
        </a>
        <a href={url('publications/')}>
          Publications <span aria-hidden="true">›</span>
        </a>
      </div>
    </section>
    <SelectedWork />
  </div>
  <AboutUs />
  <div class="section-divider page-gutter" id="directions">
    <h2 class="eyebrow">Three connected research directions</h2>
    <span>Reason · Interact · Scale</span>
  </div>
  {directions.map((direction) => (
    <section
      class:list={['direction-band', direction.id]}
      aria-labelledby={`${direction.id}-heading`}
    >
      <div class="direction-copy">
        <>
          <p class="eyebrow">{direction.verb}</p>
          <h2 id={`${direction.id}-heading`} class="display">
            {direction.headline.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </h2>
          <p>{direction.summary}</p>
          <a class="text-link" href={url(`research/#${direction.id}`)}>
            Explore{' '}
            {direction.id === 'training'
              ? 'Distributed Training'
              : direction.name}{' '}
            <span aria-hidden="true">↗</span>
          </a>
        </>
      </div>
      <DirectionArt direction={direction.id} />
    </section>
  ))}
  <section class="home-invitation page-gutter">
    <div>
      <p class="eyebrow">Join our group</p>
      <h2 class="display">
        Build what comes next,
        <br />
        with us.
      </h2>
    </div>
    <a class="text-link" href={url('join/')}>
      Opportunities & contact <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
