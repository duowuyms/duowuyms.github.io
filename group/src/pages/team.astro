---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { team, site, contacts } from '../data/site';
---

<SiteLayout title="Team" current="team/">
  <PageIntro
    eyebrow="The people behind the research"
    title="Our team."
    description={`${site.name} Research Group at ${site.affiliation}.`}
  />
  <div class="team-directory page-gutter">
    {team.map((group) => (
      <section class="people-group" id={group.id}>
        <>
          <h2 class="section-label">{group.label}</h2>
          <ul>
            {group.people.map((person) => (
              <li>
                {person.url ? (
                  <a
                    href={person.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {person.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span>{person.name}</span>
                )}
              </li>
            ))}
          </ul>
        </>
      </section>
    ))}
  </div>
  <section class="team-join" id="join" aria-labelledby="join-title">
    <div class="page-gutter">
      <h2 id="join-title" class="section-title">
        Join us
      </h2>
      <p class="intro-copy">
        Interested in agents, embodied intelligence, or the systems that make
        large-scale learning possible? We welcome prospective interns, master’s
        students, and PhD students.
      </p>
    </div>
    <div class="contact-sections page-gutter">
      <section id="apply">
        <p class="eyebrow">Opportunities</p>
        <h3 class="display">Apply to the group</h3>
        <p>
          If you are interested in a research internship, a master’s program
          through the entrance examination or recommendation, or a PhD, please
          visit our laboratory’s admissions page.
        </p>
        <p>
          Complete the application form and select our research group as your
          first preference.
        </p>
        <a
          class="text-link"
          href={site.admissions}
          target="_blank"
          rel="noopener noreferrer"
        >
          Admissions & application <span aria-hidden="true">↗</span>
        </a>
      </section>
      <section id="contact">
        <p class="eyebrow">Questions & collaboration</p>
        <h3 class="display">Get in touch</h3>
        <p>
          For questions about admissions, research directions, or our group,
          contact:
        </p>
        <div class="contact-list">
          {contacts.map((contact) => (
            <div>
              <>
                <p class="contact-area">{contact.area}</p>
                <h4>{contact.name}</h4>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</SiteLayout>
