---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { team, site, contacts } from '../data/site';

// Initials avatars: we have no verified member photos, so none are invented.
const initials = (name: string) =>
  name
    .replace(/^Prof\.\s*/, '')
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
const [advisorGroup, ...studentGroups] = team;
const advisor = advisorGroup.people[0];
---

<SiteLayout title="Team" current="team/">
  <PageIntro
    title="Our team."
    description={`${site.name} Research Group at ${site.affiliation}.`}
  />
  <div class="team-directory page-gutter">
    <section
      class="advisor"
      id={advisorGroup.id}
      aria-labelledby="advisor-name"
    >
      <span class="avatar avatar-large" aria-hidden="true">
        {initials(advisor.name)}
      </span>
      <div>
        <p class="advisor-role">{advisorGroup.label}</p>
        <h2 id="advisor-name">{advisor.name}</h2>
        <p class="advisor-affiliation">{site.affiliation}</p>
        {advisor.url && (
          <a
            class="outline-button"
            href={advisor.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Homepage<span class="sr-only">: {advisor.name}</span>
          </a>
        )}
      </div>
    </section>
    {studentGroups.map((group) => (
      <section
        class="people-group"
        id={group.id}
        aria-labelledby={`${group.id}-title`}
      >
        <h2 id={`${group.id}-title`}>
          {group.label}
          <span>{group.people.length}</span>
        </h2>
        <ul>
          {group.people.map((person) => (
            <li>
              {person.url ? (
                <a
                  class="person"
                  href={person.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="avatar" aria-hidden="true">
                    {initials(person.name)}
                  </span>
                  <span class="person-text">
                    <span class="person-name">{person.name}</span>
                    <span class="person-link">Website</span>
                  </span>
                </a>
              ) : (
                <div class="person">
                  <span class="avatar" aria-hidden="true">
                    {initials(person.name)}
                  </span>
                  <span class="person-name">{person.name}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <section class="team-join" id="join" aria-labelledby="join-title">
    <div class="page-gutter">
      <h2 id="join-title" class="section-title">
        Join us
      </h2>
      <p class="join-intro">
        Interested in agents, embodied intelligence, or the systems that make
        large-scale learning possible? We welcome prospective interns, master’s
        students, and PhD students.
      </p>
      <div class="join-columns">
        <section id="apply" aria-labelledby="apply-title">
          <h3 id="apply-title">Apply to the group</h3>
          <p>
            If you are interested in a research internship, a master’s program
            through the entrance examination or recommendation, or a PhD, visit
            our laboratory’s admissions page.
          </p>
          <p>
            Complete the application form and select our research group as your
            first preference.
          </p>
          <a
            class="outline-button"
            href={site.admissions}
            target="_blank"
            rel="noopener noreferrer"
          >
            Admissions and application
          </a>
        </section>
        <section id="contact" aria-labelledby="contact-title">
          <h3 id="contact-title">Get in touch</h3>
          <p>
            For questions about admissions, research directions, or our group,
            contact:
          </p>
          <ul class="contact-list">
            {contacts.map((contact) => (
              <li>
                <span class="contact-area">{contact.area}</span>
                <span class="contact-name">{contact.name}</span>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
